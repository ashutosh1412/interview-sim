# Which LLM backend to use: mock (free, default) | claude-cli (your subscription) | api (paid, needs key)
LLM_PROVIDER=mock

# Only read when LLM_PROVIDER=api. Never commit a real key.
ANTHROPIC_API_KEY=

# Log what would be sent (and estimated tokens) but answer from the mock provider instead.
LLM_DRY_RUN=false

# Spend guards (tokens, input + output). 0 disables the guard.
BUDGET_TOKENS_PER_SESSION=60000
BUDGET_TOKENS_PER_DAY=300000

# Mock-only: simulate a failure to test recovery. none | bad_json | timeout | rate_limit | refusal
MOCK_FAILURE=none

PORT=8787
